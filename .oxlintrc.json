{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/lib/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "src/lib חייב להיות בלתי תלוי ב-React."
              },
              {
                "name": "react-dom",
                "message": "src/lib חייב להיות בלתי תלוי ב-React."
              }
            ],
            "patterns": [
              "react/*",
              "react-dom/*",
              "../components/*",
              "../state/*"
            ]
          }
        ]
      }
    }
  ]
}
