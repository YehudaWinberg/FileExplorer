{
  "permissions": {
    "allow": [
      "Bash(npm run check)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/critical/bash-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Grep|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/files/file-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/file-system-service-guard/fs-service-guard.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "timeout": 120,
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-on-stop/check-on-stop.mjs\"" } ] }
    ]

  }
}
